{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run vercel-build",
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "dist/**",
        "prisma/schema.prisma",
        "node_modules/.prisma/client/**",
        "node_modules/@prisma/client/**",
        "node_modules/@prisma/engines/**"
      ],
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}